# Live-LLM configuration for LIVE demo mode.
# Copy to `.env` and fill in. Never commit `.env` (it is git-ignored).
# Offline mode (default) needs none of these.
#
# TWO PROVIDERS, picked in this order by build_chat_client(live=True):
#   1. Direct OpenAI  — just OPENAI_API_KEY. Simplest: a personal key, no
#      Azure resources, no Azure login. Recommended for learning/demos.
#   2. Azure OpenAI   — used only when OPENAI_API_KEY is absent. Needs an
#      Azure OpenAI resource + deployment (enterprise path).

# ---- 1. Direct OpenAI (simplest live path) ----
# Your OpenAI API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=<redacted>

# Optional: model to use (default: gpt-4o). e.g. gpt-4o-mini for cheaper runs.
# OPENAI_MODEL=gpt-4o

# ---- 2. Azure OpenAI (enterprise path; only when OPENAI_API_KEY is absent) ----
# Azure OpenAI endpoint, e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Name of the chat-model deployment (e.g. gpt-4o-mini, gpt-4.1-mini)
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Optional: API key auth. If omitted, DefaultAzureCredential is used
# (Azure CLI login / managed identity), which is the recommended path
# for Azure AI Foundry deployments.
AZURE_OPENAI_API_KEY=

# Optional: override the API version (default: 2024-12-01-preview)
# AZURE_OPENAI_API_VERSION=
