  "components": {
    "schemas": {
      "AgentRunRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Prompt for the agent",
            "default": "Run your demo task."
          },
          "formula_id": {
            "type": "string",
            "title": "Formula Id",
            "default": "sweet_bakery_cake"
          },
          "target_claims": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Claims"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "NA"
          },
          "live": {
            "type": "boolean",
            "title": "Live",
            "default": false
          }
        },
        "type": "object",
        "title": "AgentRunRequest",
        "description": "Run a single domain agent (R&D pre-phase runs first when needed)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReformulateRequest": {
        "properties": {
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario",
            "description": "Scenario id, e.g. sweet_bakery_cake"
          },
          "formula_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Formula Id"
          },
          "target_claims": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Claims"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "NA"
          },
          "live": {
            "type": "boolean",
            "title": "Live",
            "description": "Use Azure OpenAI (needs .env)",
            "default": false
          }
        },
        "type": "object",
        "title": "ReformulateRequest",
        "description": "Run the full reformulation workflow.\n\nEither ``scenario`` (one of GET /api/scenarios) or explicit\n``formula_id``/``target_claims``/``region``. Explicit fields override\nthe scenario's when both are given."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}