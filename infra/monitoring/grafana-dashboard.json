{"description":"Demo Grafana dashboard for the agent service Prometheus metrics (GET /metrics). Import via Grafana UI. All data synthetic.","panels":[{"gridPos":{"h":8,"w":12,"x":0,"y":0},"id":1,"targets":[{"expr":"sum(rate(agent_service_http_requests_total[5m])) by (route)","legendFormat":"{{route}}"}],"title":"Request rate (req/s)","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":12,"y":0},"id":2,"targets":[{"expr":"sum(rate(agent_service_errors_total[5m]))","legendFormat":"errors/s"}],"title":"Error rate (5xx/s)","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":0,"y":8},"id":3,"targets":[{"expr":"sum(rate(agent_service_http_request_duration_seconds_sum[5m])) / sum(rate(agent_service_http_request_duration_seconds_count[5m]))","legendFormat":"avg latency"}],"title":"Avg request latency (s)","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":12,"y":8},"id":4,"targets":[{"expr":"sum(rate(agent_service_agent_runs_total[5m])) by (agent)","legendFormat":"{{agent}}"}],"title":"Agent runs (per agent)","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":0,"y":16},"id":5,"targets":[{"expr":"sum(increase(agent_service_live_fallback_total[1h]))","legendFormat":"fallbacks/h"}],"title":"Live-LLM fallbacks (degraded to offline)","type":"stat"},{"gridPos":{"h":8,"w":12,"x":12,"y":16},"id":6,"targets":[{"expr":"sum(rate(agent_service_http_requests_total[5m])) by (status)","legendFormat":"{{status}}"}],"title":"Requests by status","type":"timeseries"}],"schemaVersion":39,"tags":["agentic-ai","demo"],"timezone":"utc","title":"Ingredion Agentic AI — Service Overview","version":1}